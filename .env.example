# Root environment file used by both Django and Vite during local development.

# Django Security Configuration
SECRET_KEY=django-insecure-replace-this-with-a-secure-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local backend host/port used by `python manage.py start_server`
DJANGO_HOST=127.0.0.1
DJANGO_PORT=8000

# Local frontend host/port used by Vite
VITE_HOST=127.0.0.1
VITE_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_MEDIA_BASE_URL=http://127.0.0.1:8000
VITE_BASE_URL=/
VITE_BASE_URL_PROD=/easyread/

# Docker development port mapping for the backend container
BACKEND_PORT=8001

# Database Configuration - PostgreSQL with pgvector required
DB_ENGINE=django.db.backends.postgresql
DB_NAME=easyread
DB_USER=easyread_user
DB_PASSWORD=easyread_password
DB_HOST=localhost
DB_PORT=5432

# Optional: if set, DATABASE_URL overrides the DB_* variables above
# DATABASE_URL=postgresql://easyread_user:easyread_password@localhost:5432/easyread

# AI / model provider credentials
OPENAI_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
VERTEX_PROJECT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1

# Bedrock network tuning for long-running requests
AWS_BEDROCK_CONNECT_TIMEOUT=30
AWS_BEDROCK_READ_TIMEOUT=180
AWS_BEDROCK_MAX_ATTEMPTS=3

# Frontend PDF conversion mode
# Leave false to use the local Django PDF-to-markdown endpoint
VITE_USE_EXTERNAL_PDF_CONVERTER=false
VITE_PDF_CONVERTER_URL=
VITE_PDF_CONVERTER_API_KEY=
VITE_PDF_CONVERTER_TOKEN=
VITE_PDF_CONVERTER_EMAIL=

# Performance Configuration
MAX_CONCURRENT_SIMILARITY_SEARCHES=4
MAX_THREAD_POOL_WORKERS=8
BATCH_CHUNK_SIZE=50
EMBEDDING_CACHE_TIMEOUT=3600

# AWS / EC2 evaluation example values
# DEBUG=False
# ALLOWED_HOSTS=your-domain.com,www.your-domain.com
# CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
# VITE_API_BASE_URL=/api
# VITE_MEDIA_BASE_URL=
# VITE_BASE_URL=/easyread/
# VITE_BASE_URL_PROD=/easyread/
