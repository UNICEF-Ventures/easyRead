# =============================================================================
# EasyRead Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Lines starting with # are comments. Uncomment and modify as needed.

# =============================================================================
# DJANGO CONFIGURATION
# =============================================================================

# Secret key for Django (generate a new one for production!)
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-replace-this-with-a-secure-random-key-in-production

# Debug mode (set to False in production)
DEBUG=True

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL with pgvector required)
# =============================================================================

DB_ENGINE=postgresql
DB_NAME=easyread
DB_USER=easyread_user
DB_PASSWORD=easyread_password
DB_HOST=localhost
DB_PORT=5432

# Alternative: Use DATABASE_URL instead of individual DB_* variables
# DATABASE_URL=postgresql://easyread_user:easyread_password@localhost:5432/easyread

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

DJANGO_PORT=8000
DJANGO_HOST=localhost
BACKEND_PORT=8081

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# API endpoint for the frontend
VITE_API_BASE_URL=http://127.0.0.1:8081/api

# Media files base URL
VITE_MEDIA_BASE_URL=http://127.0.0.1:8081

# Enable/disable AI image generation feature
VITE_ENABLE_IMAGE_GENERATION=false

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================

# Authentication method: 'otp' (email code) or 'oauth' (OOI Playground OIDC)
VITE_AUTH_METHOD=otp

# --- OTP Authentication (when VITE_AUTH_METHOD=otp) ---

# Resend API key for sending OTP emails (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email settings for OTP
DEFAULT_FROM_EMAIL=EasyRead <onboarding@resend.dev>

# --- OAuth/OIDC Authentication (when VITE_AUTH_METHOD=oauth) ---

# Auth0/OIDC configuration for OOI Playground integration
VITE_OIDC_DOMAIN=https://your-tenant.us.auth0.com
VITE_OIDC_AUTH_DOMAIN=https://auth.ooiplayground.com
VITE_OIDC_CLIENT_ID=your-auth0-client-id
VITE_OAUTH_NAMESPACE=https://ooi-playground.com

# Project identification
VITE_API_STAGE=dev
VITE_PROJECT_KEY=easyread

# Optional: Check if user has access to this project in their allowed-projects claim
AUTH0_CHECK_PROJECT_ACCESS=false

# =============================================================================
# SESSION CONFIGURATION
# =============================================================================

# Session duration in seconds (default: 86400 = 24 hours)
SESSION_COOKIE_AGE=86400

# Close session when browser closes
SESSION_EXPIRE_AT_BROWSER_CLOSE=false

# Use secure cookies (set to true in production with HTTPS)
SESSION_COOKIE_SECURE=false

# =============================================================================
# AI SERVICE API KEYS (at least one required for embeddings)
# =============================================================================

# OpenAI API key
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cohere API key
COHERE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini API key
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Cloud Vertex AI project
VERTEX_PROJECT_ID=your-gcp-project-id

# =============================================================================
# AWS CONFIGURATION (for Bedrock embeddings)
# =============================================================================

AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION_NAME=us-east-1

# =============================================================================
# PDF CONVERSION CONFIGURATION
# =============================================================================

# Use external PDF converter service (true) or local PyMuPDF (false)
USE_EXTERNAL_PDF_CONVERTER=false

# External PDF converter settings (only needed if USE_EXTERNAL_PDF_CONVERTER=true)
# VITE_PDF_CONVERTER_URL=https://your-converter-url.amazonaws.com/prod/file-convertor-backend
# VITE_PDF_CONVERTER_API_KEY=your-api-key
# VITE_PDF_CONVERTER_TOKEN=your-jwt-token
# VITE_PDF_CONVERTER_EMAIL=your-email@example.com

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Maximum concurrent similarity searches
MAX_CONCURRENT_SIMILARITY_SEARCHES=4

# Maximum thread pool workers for batch processing
MAX_THREAD_POOL_WORKERS=8

# Batch chunk size for processing large requests
BATCH_CHUNK_SIZE=50

# Embedding cache timeout in seconds
EMBEDDING_CACHE_TIMEOUT=3600

# =============================================================================
# EMAIL CONFIGURATION (for non-Resend SMTP)
# =============================================================================

# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# =============================================================================
# PRODUCTION CONFIGURATION
# =============================================================================
# Uncomment and modify these for production deployment:

# DEBUG=false
# SECRET_KEY=your-super-secure-production-secret-key
# ALLOWED_HOSTS=your-domain.com,www.your-domain.com
# CORS_ALLOWED_ORIGINS=https://your-domain.com
# VITE_API_BASE_URL=https://your-domain.com/api
# VITE_MEDIA_BASE_URL=https://your-domain.com
# SESSION_COOKIE_SECURE=true
