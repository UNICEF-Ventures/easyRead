# EasyRead VPS Deployment Environment Variables
# Copy this to .env in the deployment directory (/repos/easyread)

# =============================================================================
# DJANGO CONFIGURATION
# =============================================================================
DEBUG=False
SECRET_KEY=your-production-secret-key-here
ALLOWED_HOSTS=easyread.ooi.ventures,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://easyread.ooi.ventures

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_PASSWORD=your-secure-postgres-password

# =============================================================================
# AWS CONFIGURATION (for Bedrock embeddings)
# =============================================================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION_NAME=us-east-1

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================
# Auth method: 'otp' (email code) or 'oauth' (OOI Playground OIDC)
VITE_AUTH_METHOD=oauth

# OAuth/OIDC Configuration (when VITE_AUTH_METHOD=oauth)
VITE_OIDC_DOMAIN=https://your-tenant.us.auth0.com
VITE_OIDC_AUTH_DOMAIN=https://auth.ooiplayground.com
VITE_OIDC_CLIENT_ID=your-auth0-client-id
VITE_OAUTH_NAMESPACE=https://ooi-playground.com
VITE_PROJECT_KEY=easyread
AUTH0_CHECK_PROJECT_ACCESS=false

# OTP Configuration (when VITE_AUTH_METHOD=otp)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=EasyRead <onboarding@resend.dev>
